{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "src/lib/bindings.ts",
      "src/routeTree.gen.ts",
      "src/locales/keys.gen.ts",
      "src/components/ui/**",
      "src-tauri/target/**",
      "src-tauri/gen/**",
      "dist/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "include": [
        "src/lib/bindings.ts",
        "src/routeTree.gen.ts",
        "src/locales/keys.gen.ts",
        "src/components/ui/**"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
