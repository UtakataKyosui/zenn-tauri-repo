{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri App Template",
  "version": "0.1.0",
  "identifier": "com.example.tauri-app-template",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tauri App Template",
        "width": 1024,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 240,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "schemes": ["tauri-app-template"]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/UtakataKyosui/tauri-app-template/releases/latest/download/latest.json"
      ],
      "pubkey": "PLACEHOLDER_RUN_pnpm_tauri_signer_generate_AND_REPLACE_THIS_VALUE"
    }
  }
}
