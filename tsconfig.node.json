{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./node_modules/.tsc-node-out"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*.ts"]
}
